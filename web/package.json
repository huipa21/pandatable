{
  "name": "pandatable-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0 && prettier --check . && pnpm typecheck && pnpm i18n:check",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "jsonc-eslint-parser": "^2.4.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.1",
    "yaml-eslint-parser": "^1.3.0"
  }
}
